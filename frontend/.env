# 唯一前端配置：dev 与 build 共用这一份（vite.config.ts 与 src/config 都读它）。
# 新同事克隆后无需修改即可启动；换端口/后端地址/子路径只改这里。

# 左侧导航与浏览器标题使用的应用名称
VITE_APP_NAME=特种设备点检运维平台
# 所有后端接口的统一前缀（dev 代理键与浏览器请求都取这一项）
VITE_API_PREFIX=/api
# dev server 把接口前缀代理到的后端地址
VITE_PROXY_TARGET=http://127.0.0.1:8000
# 本地 dev server 监听端口
VITE_DEV_PORT=5173
# 部署子路径：根目录用 /，部署到 https://host/ops/ 时改成 /ops/
VITE_BASE_PATH=/
